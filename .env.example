APP_NAME=Denjeb 的个人博客
# 生产环境改为 false
DEBUG=true
# 生产环境改为 true（HTTPS）
SESSION_HTTPS_ONLY=false
# 生产环境改成你的域名，多个用逗号分隔
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
SECRET_KEY=change-me
# 唯一管理员邮箱，后台只允许这个邮箱登录
ADMIN_EMAIL=admin@example.com
# 后台登录是否要求邮箱验证码（SMTP 故障时可临时设为 false）
ADMIN_LOGIN_CODE_ENABLED=true
# 站点对外地址，用于邮件通知里的链接
SITE_URL=http://localhost:8000
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/blog?charset=utf8mb4
# 可选：pytest 使用的独立 MySQL 测试库；不填则使用 SQLite 测试文件
TEST_DATABASE_URL=

# 默认开启真实发信；测试环境会自动关闭。没有配置 SMTP 且 DEBUG=true 时验证码打印到终端。
EMAIL_ENABLED=true
# SMTP 留空时，验证码会打印到终端（仅开发用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 备份脚本使用的 mysqldump 路径，可用完整路径
MYSQLDUMP_PATH=mysqldump
# 保留最近多少个完整备份
BACKUP_KEEP=14
