APP_NAME=Denjeb 的个人博客
DEBUG=false
SESSION_HTTPS_ONLY=true
# 127.0.0.1 必须保留：Next.js 服务端用 http://127.0.0.1:8000 调 FastAPI，
# Starlette TrustedHostMiddleware 会校验这个 Host。
TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1

# Next.js 前台：环境变量见 frontend/.env.example。
# NEXT_PUBLIC_SITE_URL 必须在 `npm run build` 之前设置；API_BASE_URL 可放在 systemd 环境。
SECRET_KEY=replace-with-a-long-random-secret
# 唯一管理员邮箱，后台只允许这个邮箱登录
ADMIN_EMAIL=your-admin@example.com
# 后台登录是否要求邮箱验证码（SMTP 故障时可临时设为 false）
ADMIN_LOGIN_CODE_ENABLED=true
# 站点对外地址，用于邮件通知和 RSS 链接
SITE_URL=https://yourdomain.com
DATABASE_URL=mysql+pymysql://blog:password@127.0.0.1:3306/blog?charset=utf8mb4

EMAIL_ENABLED=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
SMTP_PASSWORD=你的授权码
SMTP_FROM=your-account@example.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

MYSQLDUMP_PATH=/usr/bin/mysqldump
BACKUP_KEEP=14
