[Unit]
Description=Backup blog database, uploads and content JSON
After=network.target mysql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/Denjeb-s-personal-blog
EnvironmentFile=/var/www/Denjeb-s-personal-blog/.env
ExecStart=/var/www/Denjeb-s-personal-blog/.venv/bin/python -m app.backup
