[Unit]
Description=Retry blog notification outbox
After=network.target mysql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/Denjeb-s-personal-blog
EnvironmentFile=/var/www/Denjeb-s-personal-blog/.env
ExecStart=/var/www/Denjeb-s-personal-blog/.venv/bin/python -m app.services.notifications send --limit 50
